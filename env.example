# Bu dosyayı ".env" adıyla kopyala ve doldur.

# --- E-posta hesabı ---
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=sen@gmail.com
EMAIL_PASS=uygulama_sifresi
# Gmail: normal şifre DEĞİL, "Uygulama şifresi" (2 adımlı doğrulama açık olmalı)

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:7b

# --- Güvenlik ---
# true iken hiçbir e-posta gönderilmez (önce böyle test et!)
DRY_RUN=true
MAX_SENDS_PER_RUN=10
# Otomatik gönderilecek kategoriler (boş = hepsi onay bekler). Örn: toplanti
AUTO_SEND_CATEGORIES=
# Bu kategorilere gönderilen yanıtlar takip (follow-up) için izlenir
TRACK_CATEGORIES=lead,toplanti
# Yok sayılacak gönderenler (adres veya alan adı, virgülle)
BLOCKLIST=

# --- Üslup ---
TONE=Kibar, net ve kısa yaz. E-posta hangi dildeyse o dilde yanıt ver.
SIGNATURE=Saygılarımla,\nAdın Soyadın
# Gönderilmiş klasörü (opsiyonel, geçmiş maillerinden üslup öğrenir)
# Gmail İngilizce: [Gmail]/Sent Mail   Gmail Türkçe: [Gmail]/Gönderilmiş Postalar
SENT_FOLDER=
TONE_SAMPLES=5

# --- Takip ve zamanlama ---
FOLLOWUP_AFTER_DAYS=3
MAX_FOLLOWUPS=2
POLL_MINUTES=10
FETCH_LIMIT=10
