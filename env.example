# Copy this file to ".env" and fill in your values.

# --- Email Account ---
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Gmail: NOT your regular password. Use a 16-character "App Password" (requires 2-Step Verification enabled)

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:7b

# --- Safety & Limits ---
# When true, no actual emails are sent (simulated mode). Test with this enabled first!
DRY_RUN=true
MAX_SENDS_PER_RUN=10
# Categories to automatically send without interactive review (empty = all require approval). Example: meeting
AUTO_SEND_CATEGORIES=
# Categories where replies are tracked for follow-up detection. Example: lead,meeting
TRACK_CATEGORIES=lead,meeting
# Senders to ignore (email address or domain, comma-separated)
BLOCKLIST=

# --- Tone & Persona ---
TONE=Write politely, clearly, and concisely. Reply in the same language as the incoming email.
SIGNATURE=Best regards,\nYour Name
# Sent Mail folder (optional: learns style from previously sent messages)
# Gmail English: [Gmail]/Sent Mail
SENT_FOLDER=
TONE_SAMPLES=5

# --- Follow-ups & Polling ---
FOLLOWUP_AFTER_DAYS=3
MAX_FOLLOWUPS=2
POLL_MINUTES=10
FETCH_LIMIT=10
